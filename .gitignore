# Terraform working directories and downloaded providers
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files can contain environment-specific or secret values
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
*.plan

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI config
.terraformrc
terraform.rc

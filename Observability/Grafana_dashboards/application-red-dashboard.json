        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(checkout_requests_total{kubernetes_namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "request rate",
          "range": true,
          "refId": "A"
        }
